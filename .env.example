# Configurações do Banco de Dados Principal (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_USER=ftth_admin
DB_PASSWORD=your_password_here
DB_NAME=ftth_saas

# Configurações do Redis (Cache / Fila de Processamento)
REDIS_HOST=localhost
REDIS_PORT=6379

# Configurações do Backend (API Node.js)
BACKEND_PORT=3333
JWT_SECRET=your_jwt_secret_here

# Configurações do Frontend (Next.js PWA)
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3333/api

# CORS
CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# Configurações Adicionais
NODE_ENV=development